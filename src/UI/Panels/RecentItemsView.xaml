<UserControl x:Class="DynamicBird.UI.Panels.RecentItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 最近使用项的类型兜底图标（真实图标加载成功前/失败时显示） -->
        <Style x:Key="RecentFallbackIcon"
               TargetType="Path"
               BasedOn="{StaticResource LineIcon}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Data" Value="{StaticResource IconFile}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="App">
                    <Setter Property="Data" Value="{StaticResource IconApp}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Web">
                    <Setter Property="Data" Value="{StaticResource IconWeb}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🧭 最近使用"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#EEEEEE"/>
                <TextBlock x:Name="HintText"
                           Text="最近打开的文件、运行中的程序、常用网页"
                           FontSize="10"
                           Foreground="#8A8A8A"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource FlatButton}"
                    VerticalAlignment="Center"
                    Click="Refresh_Click"
                    ToolTip="刷新">
                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconRefresh}"/>
            </Button>
        </Grid>

        <!-- 标签 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnFiles"
                    Style="{StaticResource AccentButton}"
                    Height="26"
                    Padding="8,0"
                    Click="FilesTab_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFile}" Margin="0,0,5,0"/>
                    <TextBlock Text="文件" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnApps"
                    Style="{StaticResource FlatButton}"
                    Height="26"
                    Padding="8,0"
                    Margin="6,0,0,0"
                    Click="AppsTab_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconApp}" Margin="0,0,5,0"/>
                    <TextBlock Text="程序" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnWebs"
                    Style="{StaticResource FlatButton}"
                    Height="26"
                    Padding="8,0"
                    Margin="6,0,0,0"
                    Click="WebsTab_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWeb}" Margin="0,0,5,0"/>
                    <TextBlock Text="网页" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 网页：保存常用网址输入区（仅网页标签显示） -->
        <Grid Grid.Row="2" x:Name="WebInputPanel" Margin="0,0,0,6" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WebUrlInput"
                     Grid.Column="0"
                     Style="{StaticResource DarkTextBox}"
                     FontSize="11"
                     VerticalContentAlignment="Center"
                     KeyDown="WebUrlInput_KeyDown"
                     ToolTip="输入网址后回车或点保存，例如 bilibili.com"/>
            <Button Grid.Column="1"
                    Content="＋ 保存常用"
                    Style="{StaticResource FlatButton}"
                    Margin="6,0,0,0"
                    FontSize="11"
                    Click="AddWeb_Click"/>
        </Grid>

        <!-- 列表 -->
        <ListBox Grid.Row="3"
                 x:Name="ItemList"
                 Style="{StaticResource DarkListBox}"
                 FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="Transparent"
                            Cursor="Hand"
                            Padding="2,1"
                            MouseLeftButtonUp="Item_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="18" Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                                <!-- 兜底矢量图标：文件/程序/网页各用对应图标，真实图标加载成功后覆盖 -->
                                <Path Style="{StaticResource RecentFallbackIcon}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <Image Source="{Binding Icon}"
                                       Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <Trigger Property="Source" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           Foreground="#EEEEEE"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}"
                                           FontSize="10"
                                           Foreground="#777777"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="★"
                                       FontSize="11"
                                       Foreground="#F5B301"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="3"
                                    Content="✕"
                                    Width="18" Height="18"
                                    FontSize="9"
                                    Foreground="#888888"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="RemoveWeb_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowRemove}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
