<UserControl x:Class="ShoreHue.UI.Panels.QuickSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid Margin="4" MinHeight="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="{Binding Item[UI_QuickSettingsView_113], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#EEEEEE"/>
            <TextBlock x:Name="HintText"
                       Text="{Binding Item[UI_QuickSettingsView_114], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="10"
                       Foreground="#8A8A8A"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 开关列表 -->
        <StackPanel Grid.Row="1">
            <!-- 音量 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Style="{StaticResource LineIcon}"
                          Data="{StaticResource IconVolume}"
                          Width="16" Height="16"
                          Stroke="#EEEEEE"/>
                    <Slider Grid.Column="1"
                            x:Name="VolumeSlider"
                            Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="Volume_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="VolumeText" Text="75%" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" x:Name="BtnMute"
                            Content="音"
                            Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            Click="Mute_Click"
                            ToolTip="{Binding Item[UI_QuickSettingsView_115], Source={x:Static loc:LocalizationManager.Instance}}"/>
                </Grid>
            </Border>

            <!-- 亮度 -->
            <Border x:Name="BrightnessRow" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Style="{StaticResource LineIcon}"
                          Data="{StaticResource IconSun}"
                          Width="16" Height="16"
                          Stroke="#EEEEEE"/>
                    <Slider Grid.Column="1"
                            x:Name="BrightnessSlider"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="Brightness_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="BrightnessText" Text="--" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 蓝牙 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBluetooth}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Item[UI_QuickSettingsView_116], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="BluetoothStateText" Text="{Binding Item[UI_QuickSettingsView_117], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnBluetooth"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Bluetooth_Click"/>
                </Grid>
            </Border>

            <!-- Wi-Fi -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWifi}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Wi-Fi" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="WifiStateText" Text="{Binding Item[UI_QuickSettingsView_118], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnWifi"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Wifi_Click"/>
                </Grid>
            </Border>

            <!-- 热点 -->
            <Border x:Name="HotspotRow" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconHotspot}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Item[UI_QuickSettingsView_119], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="HotspotStateText" Text="{Binding Item[UI_QuickSettingsView_120], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnHotspot"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Hotspot_Click"/>
                </Grid>
            </Border>

            <!-- ShoreHue 性能模式：四个选项直摆，点哪个切哪个 -->
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                <Button x:Name="BtnModeSmooth" Style="{StaticResource FlatButton}" Height="26" Padding="8,0"
                        Click="BirdMode_Click" Tag="Smooth">
                    <TextBlock Text="{Binding Item[Perf_Smooth], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnModeNormal" Style="{StaticResource FlatButton}" Height="26" Padding="8,0" Margin="4,0,0,0"
                        Click="BirdMode_Click" Tag="Normal">
                    <TextBlock Text="{Binding Item[Perf_Normal], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnModeSaver" Style="{StaticResource FlatButton}" Height="26" Padding="8,0" Margin="4,0,0,0"
                        Click="BirdMode_Click" Tag="PowerSaver">
                    <TextBlock Text="{Binding Item[Perf_Saver], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnModeCustom" Style="{StaticResource FlatButton}" Height="26" Padding="8,0" Margin="4,0,0,0"
                        Click="BirdMode_Click" Tag="Custom">
                    <TextBlock Text="{Binding Item[Perf_Custom], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource FlatButton}"
                        Margin="6,0,0,0"
                        Click="Settings_Click"
                        ToolTip="{Binding Item[UI_QuickSettingsView_123], Source={x:Static loc:LocalizationManager.Instance}}">
                    <TextBlock Text="{Binding Item[UI_QuickSettingsView_124], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
