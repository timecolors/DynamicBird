<UserControl x:Class="DynamicBird.UI.Panels.QuickSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="⚡ 快捷开关"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#EEEEEE"/>
            <TextBlock x:Name="HintText"
                       Text="常用系统设置快捷入口"
                       FontSize="10"
                       Foreground="#8A8A8A"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 开关列表 -->
        <StackPanel Grid.Row="1">
            <!-- 音量 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Style="{StaticResource LineIcon}"
                          Data="{StaticResource IconVolume}"
                          Width="16" Height="16"
                          Stroke="#EEEEEE"/>
                    <Slider Grid.Column="1"
                            x:Name="VolumeSlider"
                            Minimum="0" Maximum="1"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="Volume_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="VolumeText" Text="75%" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" x:Name="BtnMute"
                            Content="🔇"
                            Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            Click="Mute_Click"
                            ToolTip="静音"/>
                </Grid>
            </Border>

            <!-- 亮度 -->
            <Border x:Name="BrightnessRow" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Style="{StaticResource LineIcon}"
                          Data="{StaticResource IconSun}"
                          Width="16" Height="16"
                          Stroke="#EEEEEE"/>
                    <Slider Grid.Column="1"
                            x:Name="BrightnessSlider"
                            VerticalAlignment="Center"
                            Margin="10,0"
                            IsMoveToPointEnabled="True"
                            ValueChanged="Brightness_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="BrightnessText" Text="--" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 蓝牙 -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBell}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="蓝牙" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="BluetoothStateText" Text="检测中…" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnBluetooth"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Bluetooth_Click"/>
                </Grid>
            </Border>

            <!-- Wi-Fi -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWifi}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Wi-Fi" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="WifiStateText" Text="检测中…" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnWifi"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Wifi_Click"/>
                </Grid>
            </Border>

            <!-- 热点 -->
            <Border x:Name="HotspotRow" Style="{StaticResource CardStyle}" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconWifi}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="移动热点" FontSize="12" Foreground="#EEEEEE"/>
                        </StackPanel>
                        <TextBlock x:Name="HotspotStateText" Text="检测中…" FontSize="10" Foreground="#777777"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnHotspot"
                            Content="…"
                            Style="{StaticResource FlatButton}"
                            Width="56" Height="26"
                            Click="Hotspot_Click"/>
                </Grid>
            </Border>

            <!-- 系统入口 -->
            <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                <Button Style="{StaticResource FlatButton}"
                        Click="BatterySaver_Click"
                        ToolTip="打开省电模式设置">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBattery}" Margin="0,0,5,0"/>
                        <TextBlock Text="省电模式" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}"
                        Margin="6,0,0,0"
                        Click="Settings_Click"
                        ToolTip="打开 Windows 设置">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSettings}" Margin="0,0,5,0"/>
                        <TextBlock Text="设置" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
