<UserControl x:Class="ShoreHue.UI.Panels.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl"
             Background="Transparent" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">

    <UserControl.Resources>
        <DataTemplate x:Key="ShortcutTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="4"
                    VerticalAlignment="Stretch"
                    Tag="{Binding}">
                <Image Source="{Binding Icon}" 
                       Width="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       Height="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WindowTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="6,2"
                    VerticalAlignment="Stretch">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Column="0" 
                           Grid.Row="0"
                           Source="{Binding Icon}" 
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Grid.Row="0"
                               Text="{Binding DisplayName}" 
                               FontSize="12" 
                               Foreground="#EEEEEE"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               MaxWidth="120"/>

                    <Button Grid.Column="2" 
                            Grid.Row="0"
                            Width="18" Height="18"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            PreviewMouseUp="CloseBtn_PreviewMouseUp"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{Binding Item[UI_TaskbarView_133], Source={x:Static loc:LocalizationManager.Instance}}">
                        <Path Style="{StaticResource LineIcon}"
                              Data="{StaticResource IconClose}"
                              Width="12" Height="12"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" AllowDrop="True" />
</UserControl>
