<UserControl x:Class="DynamicBird.UI.Panels.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl"
             Background="Transparent">

    <UserControl.Resources>
        <DataTemplate x:Key="ShortcutTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="4"
                    VerticalAlignment="Stretch"
                    Tag="{Binding}">
                <Image Source="{Binding Icon}" 
                       Width="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       Height="{Binding Path=DataContext.IconSize, ElementName=RootControl, FallbackValue=28}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WindowTemplate">
            <Border Background="Transparent" 
                    Cursor="Hand"
                    Margin="2"
                    Padding="6,2"
                    VerticalAlignment="Stretch"
                    PreviewMouseLeftButtonDown="OnWindowMouseDown">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Column="0" 
                           Grid.Row="0"
                           Source="{Binding Icon}" 
                           Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" 
                               Grid.Row="0"
                               Text="{Binding DisplayName}" 
                               FontSize="12" 
                               Foreground="#EEEEEE"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               MaxWidth="120"/>

                    <Button Grid.Column="2" 
                            Grid.Row="0"
                            Content="✕" 
                            Width="18" Height="18"
                            FontSize="10"
                            Foreground="#888888"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnCloseButtonClick"
                            PreviewMouseDown="OnCloseButton_PreviewMouseDown"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="MainGrid" />
</UserControl>