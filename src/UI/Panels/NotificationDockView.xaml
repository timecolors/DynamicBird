<UserControl x:Class="ShoreHue.UI.Panels.NotificationDockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText"
                           Text="{Binding Item[UI_NotificationDockView_111], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#EEEEEE"/>
            </StackPanel>
            <Button x:Name="BtnClear"
                    Style="{StaticResource IconButton}"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="Clear_Click"
                    ToolTip="{Binding Item[UI_NotificationDockView_112], Source={x:Static loc:LocalizationManager.Instance}}">
                <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconTrash}"/>
            </Button>
        </Grid>

        <!-- 通知列表 -->
        <ListBox Grid.Row="1"
                 x:Name="NotificationList"
                 Style="{StaticResource DarkListBox}"
                 FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="Transparent"
                            Cursor="Hand"
                            Padding="2,1"
                            MouseLeftButtonUp="Item_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding AppName}"
                                           FontSize="10"
                                           Foreground="#2B88D8"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Message}"
                                           FontSize="12"
                                           Foreground="#EEEEEE"
                                           TextWrapping="Wrap"
                                           MaxHeight="60"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TimeText}"
                                       FontSize="9"
                                       Foreground="#666666"
                                       VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
