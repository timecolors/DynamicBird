<Window x:Class="DynamicBird.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动鸟 - 欢迎"
        Width="760" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F9F9F9"
        Foreground="#1E1E1E">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧步骤指示 -->
            <StackPanel Grid.Column="0" x:Name="StepPanel" Margin="0,4,26,0">
                <TextBlock Text="灵动鸟"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18"/>
                <StackPanel x:Name="Step1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border x:Name="Step1Dot" Width="22" Height="22" CornerRadius="11" Background="#0078D4" VerticalAlignment="Center">
                        <TextBlock x:Name="Step1Num" Text="1" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step1Label" Text="欢迎" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#1E1E1E"/>
                </StackPanel>
                <StackPanel x:Name="Step2" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border x:Name="Step2Dot" Width="22" Height="22" CornerRadius="11" Background="#E0E0E0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step2Num" Text="2" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step2Label" Text="边缘与四角" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                </StackPanel>
                <StackPanel x:Name="Step3" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border x:Name="Step3Dot" Width="22" Height="22" CornerRadius="11" Background="#E0E0E0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step3Num" Text="3" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step3Label" Text="任务栏操作" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                </StackPanel>
                <StackPanel x:Name="Step4" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border x:Name="Step4Dot" Width="22" Height="22" CornerRadius="11" Background="#E0E0E0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step4Num" Text="4" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step4Label" Text="图标与快捷键" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                </StackPanel>
                <StackPanel x:Name="Step5" Orientation="Horizontal">
                    <Border x:Name="Step5Dot" Width="22" Height="22" CornerRadius="11" Background="#E0E0E0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step5Num" Text="5" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step5Label" Text="设置特性" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                </StackPanel>
                <StackPanel x:Name="Step6" Orientation="Horizontal" Margin="0,12,0,0">
                    <Border x:Name="Step6Dot" Width="22" Height="22" CornerRadius="11" Background="#E0E0E0" VerticalAlignment="Center">
                        <TextBlock x:Name="Step6Num" Text="6" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Step6Label" Text="开始使用" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888888"/>
                </StackPanel>
            </StackPanel>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1">

                <!-- 第 1 页：欢迎 -->
                <StackPanel x:Name="Page1" Margin="0,10,0,0">
                    <TextBlock Text="🐦 欢迎使用灵动鸟" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="一个贴合 Windows 的桌面边缘面板工具。" FontSize="13" Foreground="#555555" TextWrapping="Wrap" LineHeight="22"/>
                    <TextBlock Text="把鼠标移到屏幕边缘，面板自动滑出；快捷操作、通知、小组件都在手边。" FontSize="13" Foreground="#555555" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
                    <Border Background="#F0F6FF" CornerRadius="8" Padding="14,10" Margin="0,24,0,0">
                        <TextBlock Text="💡 全程无需安装额外依赖：边缘触发、窗口固定、系统通知都基于 Windows 原生能力。" FontSize="12" Foreground="#2B579A" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                </StackPanel>

                <!-- 第 2 页：边缘与四角 -->
                <StackPanel x:Name="Page2" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="🎯 边缘触发与四角分工" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="上 / 下 / 左 / 右边缘" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="鼠标移到屏幕边缘即呼出对应面板，移开自动隐藏。默认分工：&#x0a;左边缘中间 = AI 助手　·　上 / 下 / 右边缘中心 = 应用辅助（画中画、媒体控制）&#x0a;上下边缘两侧 = 任务栏　·　左右边缘 = 小组件" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="每个区域显示什么面板都能在设置里自由指定（包括 AI 助手）。" FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="四个角落" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="右下 = 通知坞　·　左下 = 最近使用　·　左上 = 快捷设置（WiFi / 音量 / 亮度 / 省电）&#x0a;右上 = 不呼出（避免影响关闭窗口）。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="所有区域的显示内容和触发开关都能在设置里自定义。" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 第 3 页：任务栏操作 -->
                <StackPanel x:Name="Page3" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="📌 任务栏：固定、关闭、排序" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="固定应用" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="把正在运行的窗口标签拖到面板左上角的图标，松开即固定为快捷方式（拖放时图标会变成 ＋）。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="关闭与排序" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="窗口标签右侧的 ✕ 关闭窗口；拖动标签可调整顺序；拖快捷方式到左上角图标可移除（图标会变成垃圾桶）。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 4 页：设置与更新 -->
                <StackPanel x:Name="Page4" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="⚙️ 设置、勿扰与更新" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="灵动鸟图标" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="左键点击：切换勿扰模式；右键：打开设置 / 刷新 / 退出。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="全局热键 Ctrl + Alt + B" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="随时呼出 / 隐藏面板，不用碰屏幕边缘。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="自动更新" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="设置里配置 GitHub 仓库后，新版本会在通知坞提醒，点击即可下载更新。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 5 页：设置特性 -->
                <StackPanel x:Name="Page5" Margin="0,10,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="✨ 值得了解的设置特性" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="小鸟依人模式" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="开启后，鼠标移出面板时，面板会跟着鼠标走（像小鸟跟着人）；鼠标停下，面板就停在鼠标附近，适合把面板随手带到需要的位置。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="自适应 / 固定位置" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="每次触发自适应：面板按内容自动调整大小；取消后可用拖动面板边缘自由调整，尺寸会被记住。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="区域面板自定义" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="每个边缘/角落显示什么面板（任务栏、小组件、应用辅助、通知坞等）都能在设置里单独指定。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="状态栏快捷操作" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="面板顶部的状态栏显示时间、CPU、内存、音量等信息；把鼠标悬停在音量百分比上滚动滚轮，即可直接调大调小音量。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="左边缘中间呼出 AI 对话面板：流式回复、快捷指令（翻译 / 总结 / 解释代码 / 润色）、多会话管理。&#x0a;把图片文件拖到面板左侧的灵动鸟图标，即可把图片发给 AI 分析（需模型支持识图，如 gpt-4o、glm-4v、qwen-vl 等）。&#x0a;在 设置 → AI 中填一个 OpenAI 兼容的服务商（DeepSeek、Ollama 本地、SiliconFlow 等）与模型即可使用；API Key 只保存在本机，请求直连你选择的服务商。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="动画与外观" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="呼出/隐藏动画、缓动类型、圆角、透明度、图标大小都可以调；Win11 下还支持 Mica 毛玻璃背景。" FontSize="12" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 第 6 页：完成 -->
                <StackPanel x:Name="Page6" Margin="0,10,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="✅ 都准备好了" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    <TextBlock Text="把鼠标移到屏幕边缘试试吧。所有操作都能在设置里调整，也可以随时重新查看本引导。" FontSize="13" Foreground="#555555" TextWrapping="Wrap" LineHeight="22" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 底部导航 -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSkip" Grid.Column="0" Content="跳过" Style="{StaticResource Win11Button}" Width="76" Height="32" Click="Skip_Click"/>
            <Button x:Name="BtnPrev" Grid.Column="2" Content="上一步" Style="{StaticResource Win11Button}" Width="90" Height="32" Margin="0,0,8,0" Click="Prev_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnNext" Grid.Column="3" Content="下一步" Style="{StaticResource Win11AccentButton}" Width="90" Height="32" Click="Next_Click"/>
        </Grid>
    </Grid>
</Window>
