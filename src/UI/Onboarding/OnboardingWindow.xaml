<Window x:Class="ShoreHue.UI.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Item[Ob_Win_Title], Source={x:Static loc:LocalizationManager.Instance}}"
        Width="800" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F6FA"
        Foreground="#1E1E1E" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">

    <!-- ★ 内联主题按钮样式：OnboardingWindow 自身可解析（不依赖 App 资源环境，便于单元测试） -->
    <Window.Resources>
        <Style x:Key="Win11Button" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Win11AccentButton" TargetType="Button" BasedOn="{StaticResource Win11Button}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧步骤指示 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,20,0">
            <StackPanel x:Name="StepPanel">
                <TextBlock Text="{Binding Item[Ob_Step_Brand], Source={x:Static loc:LocalizationManager.Instance}}"
                           FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <!-- 步骤 1-10 动态生成由代码填充，这里保留占位容器 -->
                <ItemsControl x:Name="StepList"/>
            </StackPanel>
            </ScrollViewer>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1">

                <!-- ========== P1 欢迎 ========== -->
                <StackPanel x:Name="Page1" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Item[Ob_Welcome_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Welcome_Sub], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="13" Foreground="#666666" Margin="0,0,0,18"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Item[Ob_Welcome_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Item[Ob_Welcome_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Item[Ob_Welcome_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Item[Ob_Welcome_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F0F6FF" CornerRadius="10" Padding="16,12">
                        <TextBlock Text="{Binding Item[Ob_Welcome_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="#2B579A" TextWrapping="Wrap" LineHeight="20"/>
                    </Border>
                </StackPanel>

                                                                                                <!-- ========== P2 屏幕地图 ========== -->
                <ScrollViewer x:Name="Page2" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Map_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Map_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- 屏幕示意图：半透明色块按面板类型分色（红=任务栏 / 黄=应用辅助·画中画 / 蓝=小组件 / 紫=AI 助手 / 橙=四角） -->
                    <Border Background="#FFFFFF" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                        <Grid Height="240">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/><RowDefinition Height="1.1*"/><RowDefinition Height="1.9*"/><RowDefinition Height="1.1*"/><RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══ 上边缘：任务栏(红) / 应用辅助·画中画(黄) / 任务栏(红)，两端为四角 ═══ -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#DCEE8888" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Taskbar], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#E8FFDD00" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Pip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="#5B4B00" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="3" Background="#DCEE8888" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Taskbar], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ═══ 下边缘：同 ═══ -->
                            <Border Grid.Row="4" Grid.Column="1" Background="#DCEE8888" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Taskbar], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="2" Background="#E8FFDD00" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Pip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="#5B4B00" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="3" Background="#DCEE8888" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Taskbar], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ═══ 左边缘：小组件(蓝) / AI 助手(紫) / 小组件(蓝) ═══ -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#D966BBFF" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Widgets], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Background="#D8CC66FF" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Ai], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="0" Background="#D966BBFF" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Widgets], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <!-- ═══ 右边缘：小组件(蓝) / 应用辅助·画中画(黄) / 小组件(蓝) ═══ -->
                            <Border Grid.Row="1" Grid.Column="4" Background="#D966BBFF" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Widgets], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="4" Background="#E8FFDD00" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Pip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="#5B4B00" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="4" Background="#D966BBFF" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Widgets], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" TextAlignment="Center" Foreground="White" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 屏幕内容区（中） -->
                            <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="#F5F6F8" CornerRadius="6" Margin="2">
                                <TextBlock Text="{Binding Item[Ob_Map_Screen], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" TextAlignment="Center" Foreground="#BBBBBB" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 四角（橙=快捷设置/最近/通知；灰=右上安全区） -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#D0FF9900" CornerRadius="6" Margin="2">
                                <TextBlock Text="设" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="4" Background="#CCAAAAAA" CornerRadius="6" Margin="2">
                                <TextBlock Text="隐" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="0" Background="#D0FF9900" CornerRadius="6" Margin="2">
                                <TextBlock Text="近" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Row="4" Grid.Column="4" Background="#D0FF9900" CornerRadius="6" Margin="2">
                                <TextBlock Text="通" FontSize="16" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 图例（按面板类型分色） -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="14,8" Margin="0,0,0,8">
                        <WrapPanel HorizontalAlignment="Center" TextBlock.FontSize="11" TextBlock.Foreground="#555555" ItemWidth="96">
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Border Width="12" Height="12" CornerRadius="3" Background="#DCEE8888" VerticalAlignment="Center"/><TextBlock Text="{Binding Item[Ob_Map_LegendTaskbar], Source={x:Static loc:LocalizationManager.Instance}}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Border Width="12" Height="12" CornerRadius="3" Background="#E8FFDD00" VerticalAlignment="Center"/><TextBlock Text="{Binding Item[Ob_Map_LegendPip], Source={x:Static loc:LocalizationManager.Instance}}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Border Width="12" Height="12" CornerRadius="3" Background="#D966BBFF" VerticalAlignment="Center"/><TextBlock Text="{Binding Item[Ob_Map_LegendWidgets], Source={x:Static loc:LocalizationManager.Instance}}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Border Width="12" Height="12" CornerRadius="3" Background="#D8CC66FF" VerticalAlignment="Center"/><TextBlock Text="{Binding Item[Ob_Map_LegendAi], Source={x:Static loc:LocalizationManager.Instance}}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,3"><Border Width="12" Height="12" CornerRadius="3" Background="#D0FF9900" VerticalAlignment="Center"/><TextBlock Text="{Binding Item[Ob_Map_LegendCorners], Source={x:Static loc:LocalizationManager.Instance}}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </WrapPanel>
                    </Border>
                    <!-- 四角说明 -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="14,8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Item[Ob_Map_CornersText], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#555555" TextWrapping="Wrap" LineHeight="19"/>
                    </Border>
                    <!-- ★ 显著提示：一切可自定义 -->
                    <Border Background="#E8F0FE" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Item[Ob_Map_CustomTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="13" Foreground="#1E3A8A"/>
                            <TextBlock Text="{Binding Item[Ob_Map_CustomText], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2B579A" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

<!-- ========== P3 任务栏 ========== -->
                <StackPanel x:Name="Page3" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding Item[Ob_Taskbar_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Taskbar_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Taskbar_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Taskbar_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Taskbar_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Taskbar_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Taskbar_Card3Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Taskbar_Card3Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Taskbar_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>

                <!-- ========== P4 应用辅助 ========== -->
                <ScrollViewer x:Name="Page4" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Pip_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Pip_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Pip_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Pip_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Pip_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Pip_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Pip_Card3Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Pip_Card3Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Pip_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ========== P5 小组件 ========== -->
                <ScrollViewer x:Name="Page5" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Widgets_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Widgets_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Widgets_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Widgets_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Widgets_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Widgets_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Widgets_Card3Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Widgets_Card3Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Widgets_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ========== P6 快捷开关与状态栏 ========== -->
                <ScrollViewer x:Name="Page6" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Toggles_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Toggles_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Toggles_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Toggles_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Toggles_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Toggles_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Toggles_Card3Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Toggles_Card3Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Toggles_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ========== P7 AI 助手 ========== -->
                <ScrollViewer x:Name="Page7" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Ai_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Ai_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Ai_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Ai_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Ai_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Ai_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <!-- 划词翻译快捷键 -->
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Item[Ob_Ai_HotkeyTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Item[Ob_Ai_HotkeyText], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TxtOnboardingTextAiHotkey" IsReadOnly="True" FontSize="12" Height="28" VerticalContentAlignment="Center" Padding="6,0" Background="#F5F5F5" PreviewKeyDown="TxtOnboardingHotkey_PreviewKeyDown" ToolTip="{Binding Item[UI_OnboardingWindow_89], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <Button Grid.Column="1" Content="{Binding Item[UI_OnboardingWindow_90], Source={x:Static loc:LocalizationManager.Instance}}" Width="52" Height="24" Style="{StaticResource Win11Button}" FontSize="11" Margin="6,0,0,0" Click="BtnOnboardingClearHotkey_Click"/>
                            </Grid>
                            <TextBlock x:Name="TxtOnboardingHotkeyHint" Text="" FontSize="10.5" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F0F6FF" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Ai_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2B579A" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>
                </ScrollViewer>

                <!-- ========== P8 通知与最近 ========== -->
                <StackPanel x:Name="Page8" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding Item[Ob_Notify_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Notify_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Notify_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Notify_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Notify_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Notify_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Notify_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>

                <!-- ========== P9 个性化 ========== -->
                <ScrollViewer x:Name="Page9" Margin="0,6,0,0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding Item[Ob_Customize_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Item[Ob_Customize_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Customize_Card1Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Customize_Card1Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Customize_Card2Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Customize_Card2Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="{Binding Item[Ob_Customize_Card3Title], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Item[Ob_Customize_Card3Text], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/></StackPanel>
                    </Border>
                    <Border Background="#FFF8E1" CornerRadius="10" Padding="14,10"><TextBlock Text="{Binding Item[Ob_Customize_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11.5" Foreground="#8A6D00" TextWrapping="Wrap" LineHeight="19"/></Border>
                </StackPanel>
                </ScrollViewer>

                                <!-- ========== P10 完成 ========== -->
                <StackPanel x:Name="Page10" Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock Text="{Binding Item[Ob_Done_Title], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Item[Ob_Done_Sub], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" LineHeight="21" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Border Background="#FFFFFF" CornerRadius="10" Padding="18,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Item[Ob_Done_HotkeyTitle], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <!-- 快捷键 1 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#E8F0FE" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + Alt + B" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Item[Ob_Done_Hotkey1], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- 快捷键 2（动态） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#E8F0FE" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DoneHotkey2Key" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4"/>
                                </Border>
                                <TextBlock Grid.Column="1" x:Name="DoneHotkey2Desc" FontSize="12.5" Foreground="#555555" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="#EDF7ED" CornerRadius="10" Padding="14,12"><TextBlock Text="{Binding Item[Ob_Done_Tip], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="#2E7D32" TextWrapping="Wrap" LineHeight="20" TextAlignment="Center"/></Border>

                    <!-- ★ 下次不再弹出 -->
                    <CheckBox x:Name="chkNoMore" IsChecked="True" Margin="0,12,0,0" HorizontalAlignment="Center"
                              Content="{Binding Item[Ob_NoMorePrompt], Source={x:Static loc:LocalizationManager.Instance}}"
                              FontSize="12.5" Foreground="#444444" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

<!-- ============ 底部导航 ============ -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSkip" Grid.Column="0" Content="{Binding Item[UI_OnboardingWindow_108], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource Win11Button}" Width="76" Height="32" Click="Skip_Click"/>
            <Button x:Name="BtnPrev" Grid.Column="2" Content="{Binding Item[UI_OnboardingWindow_109], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource Win11Button}" Width="90" Height="32" Margin="0,0,8,0" Click="Prev_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnNext" Grid.Column="3" Content="{Binding Item[UI_OnboardingWindow_110], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource Win11AccentButton}" Width="110" Height="32" Click="Next_Click"/>
        </Grid>
    </Grid>
</Window>