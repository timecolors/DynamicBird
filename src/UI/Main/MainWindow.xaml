<Window x:Class="DynamicBird.UI.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="灵动鸟"
        Height="350"
        Width="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome 
            ResizeBorderThickness="6" 
            CaptionHeight="4"
            GlassFrameThickness="0"
            CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="MainPanel"
                Background="#2D2D2D"
                CornerRadius="16"
                Padding="6"
                Opacity="0"
                MouseEnter="MainPanel_MouseEnter"
                MouseLeave="MainPanel_MouseLeave"
                PreviewMouseDown="MainPanel_PreviewMouseDown"
                PreviewMouseMove="MainPanel_PreviewMouseMove"
                PreviewMouseUp="MainPanel_PreviewMouseUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="SystemStatusContainer" 
                                Grid.Row="0"
                                Height="28"
                                Margin="0,0,0,6"/>

                <Border Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ★★★ 图标容器（支持平移） ★★★ -->
                        <Grid Grid.Column="0"
                              x:Name="IconContainer"
                              Width="30" Height="30"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0">
                            <TextBlock x:Name="IconText"
                                       Text="🐦"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Cursor="Hand"
                                       AllowDrop="True"
                                       MouseEnter="IconText_MouseEnter"
                                       MouseLeave="IconText_MouseLeave"
                                       DragEnter="IconText_DragEnter"
                                       DragLeave="IconText_DragLeave"
                                       Drop="IconText_Drop"
                                       MouseDown="IconText_MouseDown">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="IconTranslate" X="0" Y="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <ContentControl Grid.Column="1"
                                        x:Name="ContentContainer"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>