<Window x:Class="DynamicBird.UI.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="灵动鸟"
        Height="350"
        Width="120"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#2D2D2D"
        Opacity="0"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome 
            ResizeBorderThickness="0"
            CaptionHeight="0"
            GlassFrameThickness="0"
            CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="MainPanel"
                Background="#2D2D2D"
                CornerRadius="16"
                Padding="6"
                Opacity="0"
                MouseEnter="MainPanel_MouseEnter"
                MouseLeave="MainPanel_MouseLeave"
                PreviewMouseDown="MainPanel_PreviewMouseDown"
                PreviewMouseMove="MainPanel_PreviewMouseMove"
                PreviewMouseUp="MainPanel_PreviewMouseUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="SystemStatusContainer" 
                                Grid.Row="0"
                                Height="28"
                                Margin="0,0,0,6"/>

                <Border Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ★★★ 图标容器（支持平移） ★★★ -->
                        <Grid Grid.Column="0"
                              x:Name="IconContainer"
                              Width="48" Height="48"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Background="Transparent"
                              AllowDrop="True"
                              DragEnter="IconText_DragEnter"
                              DragOver="IconText_DragOver"
                              DragLeave="IconText_DragLeave"
                              Drop="IconText_Drop">
                            <Path x:Name="IconPath"
                                  Style="{StaticResource LineIcon}"
                                  Data="{StaticResource IconLogo}"
                                  Width="24" Height="24"
                                  Cursor="Hand"
                                  MouseEnter="IconText_MouseEnter"
                                  MouseLeave="IconText_MouseLeave"
                                  MouseDown="IconText_MouseDown"
                                  MouseRightButtonUp="IconText_MouseRightButtonUp">
                                <Path.RenderTransform>
                                    <TranslateTransform x:Name="IconTranslate" X="0" Y="0"/>
                                </Path.RenderTransform>
                            </Path>
                            <Image x:Name="IconImage"
                                   Width="24" Height="24"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"
                                   Cursor="Hand"
                                   IsHitTestVisible="False"/>
                        </Grid>

                        <ContentControl Grid.Column="1"
                                        x:Name="ContentContainer"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
