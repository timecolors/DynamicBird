<Window x:Class="ShoreHue.UI.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Item[UI_MainWindow_49], Source={x:Static loc:LocalizationManager.Instance}}"
        Height="350"
        Width="120"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#2D2D2D"
        Opacity="0"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        ResizeMode="CanResize" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome
            ResizeBorderThickness="6"
            CaptionHeight="0"
            GlassFrameThickness="0"
            CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="MainPanel"
                Background="#2D2D2D"
                CornerRadius="8"
                Padding="6"
                Opacity="0"
                MouseEnter="MainPanel_MouseEnter"
                MouseLeave="MainPanel_MouseLeave"
                PreviewMouseDown="MainPanel_PreviewMouseDown"
                PreviewMouseMove="MainPanel_PreviewMouseMove"
                PreviewMouseUp="MainPanel_PreviewMouseUp">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="SystemStatusContainer" 
                                Grid.Row="0"
                                Height="28"
                                Margin="0,0,0,6"/>

                <Border Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="IconBarColumn" Width="60" MinWidth="0.2cm" MaxWidth="160"/>
                            <!-- 分隔线列：0 宽不占布局（视觉无宽度），分隔线叠在竖条/内容交界 -->
                            <ColumnDefinition Width="0"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ★★★ 左侧交互竖条：整条为热区（右键菜单/拖放固定），hover/拖放显示反馈条 ★★★ -->
                        <!-- ★ 竖条列：左扩 6 覆盖 Padding 贴面板左缘；下扩 6 贴面板底；视觉无缝 -->
                        <Grid Grid.Column="0"
                              x:Name="IconContainer"
                              HorizontalAlignment="Stretch"
                              Margin="-6,0,0,-6"
                              Background="Transparent"
                              AllowDrop="True"
                              Cursor="Hand"
                              AutomationProperties.Name="ShoreHue 交互区"
                              MouseEnter="IconText_MouseEnter"
                              MouseLeave="IconText_MouseLeave"
                              MouseDown="IconText_MouseDown"
                              MouseRightButtonUp="IconText_MouseRightButtonUp"
                              DragEnter="IconText_DragEnter"
                              DragOver="IconText_DragOver"
                              DragLeave="IconText_DragLeave"
                              Drop="IconText_Drop"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="IconShift" X="0" Y="0"/>
                            </Grid.RenderTransform>
                            <!-- hover/拖放反馈条：默认隐藏，鼠标移入或拖放时显示 -->
                            <Border x:Name="IconHoverBar"
                                    Background="#26FFFFFF"
                                    CornerRadius="6"
                                    Margin="0"
                                    Opacity="0"
                                    IsHitTestVisible="False"/>
                            <!-- ★ 拖放模式字标：拖窗口/文件进来固定显示 ＋，拖快捷方式出去删除显示 🗑
                                 （图标图形已按用户要求移除，用文字字标保留添加/删除的视觉反馈） -->
                            <TextBlock x:Name="IconModeGlyph"
                                       Text=""
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0"
                                       IsHitTestVisible="False"/>
                            <!-- 图标图形已按用户要求移除（保留元素，永不显示） -->
                            <Path x:Name="IconPath" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Image x:Name="IconImage" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- ★★★ 隐形分隔线：0 宽列内负 margin 叠在竖条/内容交界，hover 显示淡条+双向箭头，可拖调竖条宽度 ★★★ -->
                        <GridSplitter Grid.Column="1"
                                      x:Name="IconBarSplitter"
                                      Width="8"
                                      Margin="-4,0,0,-6"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      Cursor="SizeWE"
                                      MouseEnter="IconBarSplitter_MouseEnter"
                                      MouseLeave="IconBarSplitter_MouseLeave"
                                      PreviewMouseMove="IconBarSplitter_PreviewMouseMove"
                                      ResizeBehavior="BasedOnAlignment"
                                      ResizeDirection="Columns"
                                      ShowsPreview="False"/>

                        <ContentControl Grid.Column="2"
                                        x:Name="ContentContainer"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
