<Window x:Class="DynamicBird.UI.Widgets.Dynamic.WidgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C# 小组件编辑器"
        Width="640" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F9F9F9"
        Foreground="#1E1E1E">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 基本信息 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="名称" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="txtName" Text="我的小组件" FontSize="12" Padding="4,2" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="ID" VerticalAlignment="Center" FontSize="12" Margin="10,0,6,0"/>
            <TextBox Grid.Column="3" x:Name="txtId" Text="" FontSize="12" Padding="4,2" VerticalContentAlignment="Center"
                     IsReadOnly="True" Background="#EEEEEE"
                     ToolTip="ID 在创建时自动生成且唯一，不可修改"/>
        </Grid>

        <!-- 代码编辑 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="btnAiGenerate" Content="🤖 AI 生成"
                            Style="{StaticResource Win11Button}" Height="24" Margin="0,0,8,0" Click="BtnAiGenerate_Click"/>
                    <TextBox Grid.Column="1" x:Name="txtAiPrompt" FontSize="11" Height="24"
                             VerticalContentAlignment="Center" Padding="6,0"
                             ToolTip="描述你想要的小组件，例如：一个番茄钟 / 一个便签列表 / 一个汇率换算"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btnInsertPrompt" Content="📋 插入 AI 提示词" Height="24"
                                Style="{StaticResource Win11Button}" Margin="8,0,8,0"
                                ToolTip="把一段完整提示词填入输入框：复制到任意网页版 AI（免费）生成代码，再粘贴到下方代码区"
                                Click="InsertPrompt_Click"/>
                        <Button x:Name="btnAiGenerateGo" Content="生成" IsEnabled="False"
                                Style="{StaticResource Win11AccentButton}" Width="56" Height="24" Click="BtnAiGenerateGo_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="提示：点“插入 AI 提示词”可生成提示词，复制到免费网页版 AI 生成代码后粘贴到下方；或直接在上方描述后点“生成”。"
                           FontSize="10.5" Foreground="#888888" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBox Grid.Row="1" x:Name="txtCode" FontSize="12"
                     FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Padding="6,4" BorderBrush="#CCCCCC"/>
            <TextBlock Grid.Row="2" x:Name="txtCompileStatus" FontSize="11" Foreground="#888888"
                       TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="60"/>
        </Grid>

        <!-- 操作 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="PreviewBox" Background="#2D2D2D" CornerRadius="8" Padding="8"
                    MinHeight="64" Margin="0,0,12,0">
                <ContentControl x:Name="PreviewHost" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
            </Border>
            <Button Grid.Column="1" x:Name="btnPreview" Content="编译预览" Style="{StaticResource Win11Button}" Width="90" Height="30" Margin="0,0,8,0" Click="Preview_Click"/>
            <Button Grid.Column="2" x:Name="btnSave" Content="保存" Style="{StaticResource Win11AccentButton}" Width="80" Height="30" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Grid.Column="3" x:Name="btnCancel" Content="取消" Style="{StaticResource Win11Button}" Width="80" Height="30" Click="Cancel_Click"/>
        </Grid>
    </Grid>
</Window>
