<UserControl x:Class="DynamicBird.UI.Widgets.WidgetSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 固定头部 -->
            <RowDefinition Height="*"/>
            <!-- 滚动内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 固定底部 -->
        </Grid.RowDefinitions>

        <!-- ★★★ 固定头部：切换按钮 ★★★ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" x:Name="ButtonPanel">
            <Button x:Name="BtnClipboard" 
                    Style="{StaticResource AccentButton}"
                    Height="28"
                    Padding="8,0"
                    Click="BtnClipboard_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconClipboard}" Margin="0,0,5,0"/>
                    <TextBlock Text="剪贴板" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnNote" 
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="BtnNote_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconNote}" Margin="0,0,5,0"/>
                    <TextBlock Text="便签" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnTimer"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="BtnTimer_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconTimer}" Margin="0,0,5,0"/>
                    <TextBlock Text="计时" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnCalc"
                    Height="28"
                    Padding="8,0"
                    Margin="8,0,0,0"
                    Click="BtnCalc_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconCalc}" Margin="0,0,5,0"/>
                    <TextBlock Text="计算" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ★★★ 滚动内容区 ★★★ -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="ContentContainer" />
        </ScrollViewer>

        <!-- ★★★ 固定底部：状态/操作按钮占位（由子控件自己提供） ★★★ -->
        <Border Grid.Row="2" Height="32" Margin="0,8,0,0" x:Name="FooterPanel"/>
    </Grid>
</UserControl>
