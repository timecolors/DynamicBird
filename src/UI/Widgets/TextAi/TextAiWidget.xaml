<UserControl x:Class="DynamicBird.UI.Widgets.TextAi.TextAiWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DynamicBird.UI.Localization">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 头部 -->
            <RowDefinition Height="*"/>
            <!-- 滚动内容 -->
        </Grid.RowDefinitions>

        <!-- ===== 头部：标题 + 设置 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Item[UI_TextAiWidget_409], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="BtnOpenSettings" Content="{Binding Item[UI_TextAiWidget_410], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource FlatButton}" Padding="8,2" Height="24"
                    Click="OpenSettings_Click"/>
        </Grid>

        <!-- ===== 内容区 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 选中文本 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="{Binding Item[UI_TextAiWidget_411], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" Foreground="#8A8A8A" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SourceText" FontSize="12" Foreground="#CCCCCC"
                                   TextWrapping="Wrap" MaxHeight="140"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- 译文 -->
                <Border Style="{StaticResource CardStyle}" Padding="8,6">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Item[UI_TextAiWidget_412], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="StateText" Margin="10,0,0,0" FontSize="10.5"
                                       Foreground="#8A8A8A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" x:Name="BtnCopyResult" Content="{Binding Item[TextAi_Copy], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Padding="8,2" Height="22" FontSize="11" Click="CopyResult_Click"/>

                        </Grid>
                        <TextBlock x:Name="ResultText" FontSize="13" Foreground="#EEEEEE"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
