<UserControl x:Class="ShoreHue.UI.AppHelper.MediaControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Text="{Binding Item[UI_MediaControlView_37], Source={x:Static loc:LocalizationManager.Instance}}"
                       FontSize="11"
                       Foreground="#8A8A8A"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1"
                    Style="{StaticResource FlatButton}"
                    Height="26"
                    Click="Refresh_Click"
                    ToolTip="{Binding Item[UI_MediaControlView_38], Source={x:Static loc:LocalizationManager.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconRefresh}" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Item[UI_MediaControlView_39], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 媒体会话列表 -->
        <ListBox Grid.Row="1"
                 x:Name="SessionList"
                 Style="{StaticResource DarkListBox}"
                 FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,8,0">
                            <!-- 无封面时的默认音乐占位 -->
                            <TextBlock Text="♪"
                                       FontSize="18"
                                       Foreground="#555555"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Image Source="{Binding Thumbnail}"
                                   Width="40" Height="40"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding AppName}"
                                       FontSize="10"
                                       Foreground="#8A8A8A"/>
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="12"
                                       Foreground="#EEEEEE"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Click="Prev_Click"
                                ToolTip="{Binding Item[UI_MediaControlView_40], Source={x:Static loc:LocalizationManager.Instance}}">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconPrev}"/>
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButton}"
                                Click="PlayPause_Click"
                                ToolTip="{Binding Item[UI_MediaControlView_41], Source={x:Static loc:LocalizationManager.Instance}}">
                            <Path Style="{StaticResource LineIcon}" Data="{Binding PlayGlyph}"/>
                        </Button>
                        <Button Grid.Column="4"
                                Style="{StaticResource IconButton}"
                                Click="Next_Click"
                                ToolTip="{Binding Item[UI_MediaControlView_42], Source={x:Static loc:LocalizationManager.Instance}}">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconNext}"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
