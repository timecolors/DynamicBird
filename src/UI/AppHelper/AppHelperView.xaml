<UserControl x:Class="DynamicBird.UI.AppHelper.AppHelperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="PageTitle"
                           Text="媒体控制"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#EEEEEE"/>
                <TextBlock x:Name="PageHint"
                           Text="控制正在播放的媒体应用"
                           FontSize="10"
                           Foreground="#8A8A8A"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPrevPage"
                        Content="◀"
                        Style="{StaticResource IconButton}"
                        Click="PrevPage_Click"
                        ToolTip="上一页"/>
                <TextBlock x:Name="PageIndicator"
                           Text="1/3"
                           FontSize="11"
                           Foreground="#8A8A8A"
                           VerticalAlignment="Center"
                           Margin="6,0"/>
                <Button x:Name="BtnNextPage"
                        Content="▶"
                        Style="{StaticResource IconButton}"
                        Click="NextPage_Click"
                        ToolTip="下一页"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Row="1" x:Name="PageContent"/>
    </Grid>
</UserControl>
