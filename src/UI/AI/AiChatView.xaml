<UserControl x:Class="ShoreHue.UI.AI.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="400" d:DesignHeight="520" xmlns:loc="clr-namespace:ShoreHue.UI.Localization">
    <Grid Margin="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：图标 + 标题 + 模型 + 工具按钮 -->
        <Grid Grid.Row="0" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Style="{StaticResource LineIconAccent}" Data="{StaticResource IconAi}"
                  Width="18" Height="18" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Item[UI_AiChatView_1], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="#EEEEEE"/>
                <TextBlock x:Name="ModelText" Text="" FontSize="10" Foreground="#8A8A8A" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnSettings" Content="⚙" Style="{StaticResource FlatButton}" Height="26" Width="28"
                        FontSize="12" Click="BtnSettings_Click" ToolTip="{Binding Item[UI_AiChatView_2], Source={x:Static loc:LocalizationManager.Instance}}" Margin="0,0,4,0"/>
                <Button x:Name="BtnClear" Content="{Binding Item[UI_AiChatView_3], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="26" Padding="8,0"
                        FontSize="11" Click="BtnClear_Click" ToolTip="{Binding Item[UI_AiChatView_4], Source={x:Static loc:LocalizationManager.Instance}}"/>
            </StackPanel>
        </Grid>

        <!-- 会话管理行 -->
        <Grid Grid.Row="1" Margin="2,0,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SessionCombo" Grid.Column="0"
                      Height="26" FontSize="12"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Title"
                      SelectionChanged="SessionCombo_SelectionChanged"/>
            <Button x:Name="BtnNewSession" Grid.Column="1" Content="{Binding Item[UI_AiChatView_5], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource FlatButton}" Height="26" Padding="10,0" FontSize="11.5"
                    Margin="6,0,0,0" Click="BtnNewSession_Click" ToolTip="{Binding Item[UI_AiChatView_6], Source={x:Static loc:LocalizationManager.Instance}}"/>
            <Button x:Name="BtnDeleteSession" Grid.Column="2" Content="{Binding Item[UI_AiChatView_7], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource FlatButton}" Height="26" Padding="10,0" FontSize="11.5"
                    Margin="6,0,0,0" Click="BtnDeleteSession_Click" ToolTip="{Binding Item[UI_AiChatView_8], Source={x:Static loc:LocalizationManager.Instance}}"/>
        </Grid>

        <!-- 消息区 -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="MsgScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,4">
                <ItemsControl x:Name="MsgList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 用户消息：右侧气泡 -->
                                <Border Grid.Column="1" x:Name="UserBubble"
                                        Background="#1F5FA8" CornerRadius="10" Padding="10,7"
                                        MaxWidth="300" HorizontalAlignment="Right"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Image x:Name="UserImage" Source="{Binding ImagePath}"
                                               MaxWidth="240" MaxHeight="200" Stretch="Uniform"
                                               Margin="0,0,0,6" Visibility="Collapsed"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PlainText}" TextWrapping="Wrap"
                                                       FontSize="12.5" Foreground="White"/>
                                            <Button Content="✏" ToolTip="{Binding Item[UI_AiChatView_9], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#B8D4F5" FontSize="11" Padding="4,0"
                                                    Cursor="Hand" VerticalAlignment="Top" Margin="4,0,0,0"
                                                    Click="UserEdit_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- AI 消息：左侧卡片 + 操作按钮 -->
                                <Border Grid.Column="0" x:Name="AiCard"
                                        Background="#3A3A42" CornerRadius="10" Padding="8,6"
                                        Margin="0,0,24,0" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <FlowDocumentScrollViewer Grid.Row="0" Document="{Binding Document}"
                                                                   VerticalScrollBarVisibility="Disabled"
                                                                   IsToolBarVisible="False"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0"
                                                    HorizontalAlignment="Right">
                                            <Button Content="{Binding Item[UI_AiChatView_10], Source={x:Static loc:LocalizationManager.Instance}}" ToolTip="{Binding Item[UI_AiChatView_11], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Style="{StaticResource FlatButton}" Height="20" FontSize="10" Padding="6,0"
                                                    Click="AiCopy_Click" Tag="{Binding}"/>
                                            <Button Content="{Binding Item[UI_AiChatView_12], Source={x:Static loc:LocalizationManager.Instance}}" ToolTip="{Binding Item[UI_AiChatView_13], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Style="{StaticResource FlatButton}" Height="20" FontSize="10" Padding="6,0" Margin="2,0,0,0"
                                                    Click="AiRegen_Click" Tag="{Binding}"/>
                                            <Button Content="{Binding Item[UI_AiChatView_14], Source={x:Static loc:LocalizationManager.Instance}}" ToolTip="{Binding Item[UI_AiChatView_15], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    Style="{StaticResource FlatButton}" Height="20" FontSize="10" Padding="6,0" Margin="2,0,0,0"
                                                    Click="AiSave_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <!-- 错误/状态 -->
                                <TextBlock Grid.Column="0" x:Name="ErrText"
                                           Text="{Binding PlainText}" TextWrapping="Wrap"
                                           FontSize="11.5" Foreground="#FF9A8B"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="UserBubble" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                    <Setter TargetName="AiCard" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="ErrText" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                    <Setter TargetName="UserImage" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- 空状态 / 未配置引导 -->
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <Path Style="{StaticResource LineIconAccent}" Data="{StaticResource IconAi}"
                      Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="EmptyTitle" Text="{Binding Item[UI_AiChatView_16], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#EEEEEE" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Text="{Binding Item[UI_AiChatView_17], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12"
                           Foreground="#8A8A8A" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"/>
                <StackPanel x:Name="ExamplePanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Content="{Binding Item[UI_AiChatView_18], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="26" FontSize="11.5" Padding="10,0" Click="Example_Click" Tag="translate"/>
                    <Button Content="{Binding Item[UI_AiChatView_19], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="26" FontSize="11.5" Padding="10,0" Margin="6,0,0,0" Click="Example_Click" Tag="summarize"/>
                    <Button Content="{Binding Item[UI_AiChatView_20], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="26" FontSize="11.5" Padding="10,0" Margin="6,0,0,0" Click="Example_Click" Tag="explain"/>
                </StackPanel>
                <Button x:Name="BtnEmptySettings" Content="{Binding Item[UI_AiChatView_21], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource AccentButton}"
                        Height="30" FontSize="12" Padding="14,0" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Click="BtnSettings_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- 快捷指令行：快捷按钮 + 输出到光标（不挤压） -->
        <Grid Grid.Row="3" Margin="2,4,2,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Item[UI_AiChatView_22], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button Content="{Binding Item[UI_AiChatView_23], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="8,0" Click="Preset_Click" Tag="translate"/>
                <Button Content="{Binding Item[UI_AiChatView_24], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="8,0" Margin="4,0,0,0" Click="Preset_Click" Tag="summarize"/>
                <Button Content="{Binding Item[UI_AiChatView_25], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="8,0" Margin="4,0,0,0" Click="Preset_Click" Tag="explain"/>
                <Button Content="{Binding Item[UI_AiChatView_26], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="8,0" Margin="4,0,0,0" Click="Preset_Click" Tag="polish"/>
            </StackPanel>
            <Button x:Name="BtnCursorOutput" Grid.Column="1" Content="{Binding Item[UI_AiChatView_27], Source={x:Static loc:LocalizationManager.Instance}}"
                    Style="{StaticResource FlatButton}" Height="24" Padding="8,0" FontSize="11"
                    ToolTip="{Binding Item[UI_AiChatView_28], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="BtnCursorOutput_Click"/>
        </Grid>

        <!-- 输入行：单行输入 + 展开按钮 + 发送/停止 -->
        <Grid Grid.Row="4" Margin="2,0,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0"
                     Style="{StaticResource DarkTextBox}"
                     MinHeight="30" MaxHeight="110" Height="30"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Center"
                     FontSize="12.5"
                     AutomationProperties.AutomationId="AiInput"
                     PreviewKeyDown="InputBox_PreviewKeyDown"
                     ToolTip="{Binding Item[UI_AiChatView_29], Source={x:Static loc:LocalizationManager.Instance}}"/>
            <Button x:Name="BtnExpandInput" Grid.Column="1" Content="↕"
                    Style="{StaticResource FlatButton}" Width="26" Height="30" FontSize="13"
                    ToolTip="{Binding Item[UI_AiChatView_30], Source={x:Static loc:LocalizationManager.Instance}}"
                    Click="BtnExpandInput_Click" Margin="4,0,0,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,0">
                <Button x:Name="BtnSend" Content="{Binding Item[UI_AiChatView_31], Source={x:Static loc:LocalizationManager.Instance}}" Style="{StaticResource AccentButton}"
                        Width="58" Height="30" FontSize="12" Click="BtnSend_Click"
                        AutomationProperties.AutomationId="AiSend"/>
                <Button x:Name="BtnStop" Content="■" Style="{StaticResource FlatButton}"
                        Width="30" Height="30" FontSize="11" Margin="4,0,0,0"
                        Click="BtnStop_Click" Visibility="Collapsed" ToolTip="{Binding Item[UI_AiChatView_32], Source={x:Static loc:LocalizationManager.Instance}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>