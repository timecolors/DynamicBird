<Window x:Class="DynamicBird.UI.Settings.WeatherCityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择城市"
        Width="420" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F9F9F9"
        Foreground="#1E1E1E">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索 -->
        <TextBox Grid.Row="0" x:Name="TxtSearch" FontSize="13" Height="32"
                 VerticalContentAlignment="Center" Padding="8,0"
                 TextChanged="TxtSearch_TextChanged"
                 ToolTip="输入城市名搜索，如 北京 / Shanghai / New York"/>

        <!-- 最近使用 + 热门城市（国内/国际分组） -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="RecentTitle" Text="最近使用" FontSize="11" Foreground="#888888" Margin="0,0,0,6" Visibility="Collapsed"/>
            <WrapPanel x:Name="RecentPanel" Margin="0,0,0,4">
            </WrapPanel>

            <TextBlock x:Name="DomesticTitle" Text="国内热门" FontSize="11" Foreground="#888888" Margin="0,4,0,6"/>
            <WrapPanel x:Name="DomesticPanel">
            </WrapPanel>

            <TextBlock x:Name="InternationalTitle" Text="国际热门" FontSize="11" Foreground="#888888" Margin="0,4,0,6"/>
            <WrapPanel x:Name="InternationalPanel">
            </WrapPanel>
        </StackPanel>

        <!-- 天气预览 + 搜索结果 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" x:Name="WeatherPreviewBox" Background="#F0F6FF"
                    CornerRadius="6" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="WeatherPreview" FontSize="12" Foreground="#2B579A" TextWrapping="Wrap"/>
            </Border>
            <ListBox Grid.Row="1" x:Name="ResultList"
                     FontSize="13" BorderBrush="#DDDDDD"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     DisplayMemberPath="Label"/>
        </Grid>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource Win11Button}" Width="76" Height="30" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="BtnOk" Content="确定" Style="{StaticResource Win11AccentButton}" Width="76" Height="30" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
