<Page x:Class="DynamicBird.UI.Settings.Pages.ShortcutManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{Binding Item[UI_ShortcutManagementPage_396], Source={x:Static loc:LocalizationManager.Instance}}"
      Background="Transparent"
      Foreground="#1E1E1E" xmlns:loc="clr-namespace:DynamicBird.UI.Localization">

    <Page.Resources>
        <Style x:Key="LightButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentLightButton" TargetType="Button" BasedOn="{StaticResource LightButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        <Style x:Key="DangerLightButton" TargetType="Button" BasedOn="{StaticResource LightButton}">
            <Setter Property="Background" Value="#FFF4F4"/>
            <Setter Property="Foreground" Value="#C42B1C"/>
            <Setter Property="BorderBrush" Value="#F0C0BB"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnAddShortcut" 
                    Content="{Binding Item[UI_ShortcutManagementPage_397], Source={x:Static loc:LocalizationManager.Instance}}" 
                    Width="140" Height="30"
                    Style="{StaticResource AccentLightButton}"
                    Click="BtnAddShortcut_Click"/>
            <Button x:Name="BtnClearAll" 
                    Content="{Binding Item[UI_ShortcutManagementPage_398], Source={x:Static loc:LocalizationManager.Instance}}" 
                    Width="100" Height="30"
                    Style="{StaticResource DangerLightButton}"
                    Margin="10,0,0,0"
                    Click="BtnClearAll_Click"/>
            <TextBlock x:Name="TxtStatus" 
                       Text="{Binding Item[UI_ShortcutManagementPage_399], Source={x:Static loc:LocalizationManager.Instance}}" 
                       FontSize="11" 
                       Foreground="#888888"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <!-- ★★★ 移除了图标大小控制区域（已移到主设置页面） ★★★ -->

        <!-- 快捷方式列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ShortcutList" Background="Transparent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F5F5F5" 
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" 
                                       Source="{Binding Icon}" 
                                       Width="24" Height="24"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Name}" 
                                           FontSize="13" 
                                           Foreground="#1E1E1E"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="2" 
                                        Content="↑" 
                                        Width="28" Height="28"
                                        FontSize="14"
                                        Background="Transparent"
                                        Foreground="#555555"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnMoveUp_Click"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="3" 
                                        Content="↓" 
                                        Width="28" Height="28"
                                        FontSize="14"
                                        Background="Transparent"
                                        Foreground="#555555"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnMoveDown_Click"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="4" 
                                        Content="✕" 
                                        Width="28" Height="28"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="#555555"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="BtnDelete_Click"
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部提示 -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding Item[UI_ShortcutManagementPage_400], Source={x:Static loc:LocalizationManager.Instance}}" 
                   FontSize="11" 
                   Foreground="#888888"
                   Margin="0,10,0,0"/>
    </Grid>
</Page>
