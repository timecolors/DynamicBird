                                                       Style="{StaticResource InfoTipStyle}"
                                                       HorizontalAlignment="Right"
                                                       ToolTip="跨边飞行时的移动速度。数值越小飞行越快，数值越大飞行越慢。"/>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="100ms"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="#888888"/>
                                            <Slider Grid.Row="0" Grid.Column="1"
                                                    x:Name="sldFlyDuration"
                                                    Minimum="100" Maximum="2000" Value="500"
                                                    TickFrequency="50" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       x:Name="txtFlyDuration"
                                                       Text="500ms"
                                                       TextAlignment="Center"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ====== 延时隐藏 ====== -->
                                <Border Background="#FFFFFF"
                                        CornerRadius="8"
                                        Padding="8,6">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="⏱️ 延时隐藏"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource InfoTipStyle}"
                                                       HorizontalAlignment="Right"
                                                       ToolTip="鼠标移出面板后，延迟多久开始隐藏动画"/>
                                        </Grid>

                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="等待时间"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                            <Slider Grid.Row="0" Grid.Column="1"
                                                    x:Name="sldHideDelay"
                                                    Minimum="0" Maximum="1000" Value="200"
                                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                       x:Name="txtHideDelay"
                                                       Text="200ms"
                                                       TextAlignment="Center"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="11" Foreground="#888888"
                                   Text="💡 关闭动画后，呼出/隐藏/切换均为瞬间完成。延时隐藏仍会生效（面板会在延迟后瞬间消失）。飞行特性在关闭动画时仍保留（面板不消失，但形变瞬间完成）。"
                                   TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnOnboarding"
                    Content="查看引导"
                    Style="{StaticResource Win11Button}"
                    Width="90" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnOnboarding_Click"/>
            <Button x:Name="btnSave"
                    Content="保存"
                    Style="{StaticResource Win11AccentButton}"
                    Width="76" Height="30"
                    Margin="0,0,8,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="btnClose"
                    Content="关闭"
                    Style="{StaticResource Win11Button}"
                    Width="76" Height="30"
                    Click="BtnClose_Click"/>
            <TextBlock Style="{StaticResource InfoTipStyle}" ToolTip="保存当前设置到 config.json，关闭后设置生效。"/>
        </StackPanel>
    </Grid>
</Window>
