<Window x:Class="DynamicBird.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicBird.UI.Settings"
        Title="🐦 灵动鸟 设置"
        Height="600" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F9F9F9"
        Foreground="#1E1E1E"
        MinHeight="500" MinWidth="650">

    <Window.Resources>
        <Style x:Key="InfoTipStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="ⓘ"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InfoTipButtonStyle" TargetType="Button">
            <Setter Property="Content" Value="ⓘ"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Win11 浅色标签页 -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="14,6"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="🐦 灵动鸟 设置"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,12"/>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="#DDDDDD"
                    FontSize="12.5">

            <!-- ====== 选项卡1：任务栏设置 ====== -->
            <TabItem Header="⚙️ 任务栏">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>

                        <!-- ========== 分组1：布局与显示 ========== -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📐 布局与显示"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="图标大小" VerticalAlignment="Center" FontSize="12" Width="60"/>
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="sldIconSize"
                                            Minimum="16" Maximum="48" Value="28"
                                            TickFrequency="2" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtIconSize"
                                               Text="28px" TextAlignment="Center" Width="40" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="快捷方式图标的显示大小。范围 16-48px，调整后需要重新触发面板才会生效。"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="标签宽度" VerticalAlignment="Center" FontSize="12" Width="60"/>
                                    <Slider Grid.Row="1" Grid.Column="1" x:Name="sldTagWidth"
                                            Minimum="40" Maximum="300" Value="120"
                                            TickFrequency="5" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="txtTagWidth"
                                               Text="120px" TextAlignment="Center" Width="40" FontSize="12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="任务标签文字的最大宽度，超宽部分自动截断显示省略号。"/>

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="圆角" VerticalAlignment="Center" FontSize="12" Width="40" Margin="8,0,0,0"/>
                                    <Slider Grid.Row="0" Grid.Column="5" x:Name="sldCornerRadius"
                                            Minimum="0" Maximum="30" Value="16"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="6" x:Name="txtCornerRadiusValue"
                                               Text="16" TextAlignment="Center" Width="30" FontSize="12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="透明度" VerticalAlignment="Center" FontSize="12" Width="40" Margin="8,0,0,0"/>
                                    <Slider Grid.Row="1" Grid.Column="5" x:Name="sldOpacity"
                                            Minimum="0" Maximum="1" Value="0.85"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="6" x:Name="txtOpacityValue"
                                               Text="0.85" TextAlignment="Center" Width="30" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组2：触发与位置 ========== -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎯 触发与位置"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>

                                <WrapPanel Margin="0,0,0,6">
                                    <CheckBox x:Name="chkTop" Content="上边" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottom" Content="下边" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkLeft" Content="左边" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkRight" Content="右边" Margin="0,0,12,3"/>
                                    <TextBlock Style="{StaticResource InfoTipStyle}"
                                               ToolTip="勾选后，鼠标移动到对应屏幕边缘时会弹出面板。"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox x:Name="chkTopLeft" Content="左上角" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkTopRight" Content="右上角" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottomLeft" Content="左下角" Margin="0,0,12,3"/>
                                    <CheckBox x:Name="chkBottomRight" Content="右下角" Margin="0,0,12,3"/>
                                    <TextBlock Style="{StaticResource InfoTipStyle}"
                                               ToolTip="勾选后，鼠标移动到屏幕角落时会弹出面板（角落触发优先级高于边缘）。"/>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="边" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="行为模式" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="形状" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="上" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbTopMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="跟随鼠标"/>
                                        <ComboBoxItem Content="固定位置"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="形状" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbFixedShapeTop" Width="90" FontSize="12">
                                        <ComboBoxItem Content="方形"/>
                                        <ComboBoxItem Content="横条"/>
                                        <ComboBoxItem Content="竖条"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="4" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="跟随鼠标：面板跟随鼠标在边缘的位置移动。固定位置：面板固定在边缘的特定位置。"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="下" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbBottomMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="跟随鼠标"/>
                                        <ComboBoxItem Content="固定位置"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="形状" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cmbFixedShapeBottom" Width="90" FontSize="12">
                                        <ComboBoxItem Content="方形"/>
                                        <ComboBoxItem Content="横条"/>
                                        <ComboBoxItem Content="竖条"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="左" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbLeftMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="跟随鼠标"/>
                                        <ComboBoxItem Content="固定位置"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="形状" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cmbFixedShapeLeft" Width="90" FontSize="12">
                                        <ComboBoxItem Content="方形"/>
                                        <ComboBoxItem Content="横条"/>
                                        <ComboBoxItem Content="竖条"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="跟随鼠标：面板跟随鼠标在边缘的位置移动。固定位置：面板固定在边缘的特定位置。"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="右" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbRightMode" Width="100" FontSize="12">
                                        <ComboBoxItem Content="跟随鼠标"/>
                                        <ComboBoxItem Content="固定位置"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="形状" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="3" x:Name="cmbFixedShapeRight" Width="90" FontSize="12">
                                        <ComboBoxItem Content="方形"/>
                                        <ComboBoxItem Content="横条"/>
                                        <ComboBoxItem Content="竖条"/>
                                    </ComboBox>
                                    <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="跟随鼠标：面板跟随鼠标在边缘的位置移动。固定位置：面板固定在边缘的特定位置。"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组：区域面板 ========== -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🗂 区域面板"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="为每个边缘/角落指定显示的面板。选择“默认布局”则使用现在的默认分配。"
                                           FontSize="11"
                                           Foreground="#777777"
                                           Margin="0,0,0,6"
                                           TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="上-左" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbPanel_Top_Left" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="上-中" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="0" Grid.Column="3" x:Name="cmbPanel_Top_Center" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="上-右" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbPanel_Top_Right" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="下-左" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cmbPanel_Bottom_Left" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="下-中" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbPanel_Bottom_Center" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="下-右" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="cmbPanel_Bottom_Right" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="左-上" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbPanel_Left_Top" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="左-中" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="3" Grid.Column="3" x:Name="cmbPanel_Left_Center" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="左-下" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cmbPanel_Left_Bottom" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="右-上" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="4" Grid.Column="3" x:Name="cmbPanel_Right_Top" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="右-中" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cmbPanel_Right_Center" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="右-下" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="5" Grid.Column="3" x:Name="cmbPanel_Right_Bottom" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="左上角" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cmbPanel_TopLeft" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="右上角" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="6" Grid.Column="3" x:Name="cmbPanel_TopRight" Width="110" FontSize="11" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="左下角" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cmbPanel_BottomLeft" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="右下角" VerticalAlignment="Center" FontSize="12"/>
                                    <ComboBox Grid.Row="7" Grid.Column="3" x:Name="cmbPanel_BottomRight" Width="110" FontSize="11" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组3：外观 ========== -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎨 外观"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="背景色" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtBgColor" Text="#2D2D2D" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Row="0" Grid.Column="2" x:Name="btnBgColorPicker" Content="选择" Width="50" Height="22" Style="{StaticResource Win11Button}" Click="BtnBgColorPicker_Click" FontSize="11" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="文字色" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtTextColor" Text="#FFFFFF" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Row="0" Grid.Column="5" x:Name="btnTextColorPicker" Content="选择" Width="50" Height="22" Style="{StaticResource Win11Button}" Click="BtnTextColorPicker_Click" FontSize="11" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="自定义图标" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCustomIcon" Text="" IsReadOnly="True" VerticalAlignment="Center" FontSize="12" Background="#EEEEEE" Grid.ColumnSpan="2"/>
                                    <Button Grid.Row="1" Grid.Column="3" x:Name="btnSelectIcon" Content="选择图片" Width="70" Height="22" Style="{StaticResource Win11Button}" Click="BtnSelectIcon_Click" FontSize="11" Margin="8,0,0,0" Grid.ColumnSpan="2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="选择一张图片替换灵动鸟图标（支持 PNG、JPG、ICO 等格式）。"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkShowSystemStatus" Content="显示系统状态" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="在面板顶部显示时间、CPU、内存、音量、网络、电池、FPS 等信息。"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== 分组4：高级设置 ========== -->
                        <Border Background="#FFFFFF"
                                CornerRadius="8"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚡ 高级设置"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="布局阈值" VerticalAlignment="Center" FontSize="12"/>
                                    <Slider Grid.Row="0" Grid.Column="1" x:Name="sldHorizontalThreshold"
                                            Minimum="0.1" Maximum="0.9" Value="0.43"
                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtHorizontalThreshold"
                                               Text="43%" TextAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource InfoTipStyle}" Grid.ColumnSpan="4"
                                               ToolTip="控制面板在横向/纵向布局之间切换的宽高比阈值。值越大，需要越宽的面板才会切换到横向布局。"/>

                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="chkAutoFitOnTrigger"
                                              Content="每次触发自适应"
                                              Margin="0,2,0,2" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="开启：每次触发边缘时自动适配内容大小。关闭：保持手动拖拽调整的尺寸。"/>

                                    <CheckBox Grid.Column="2" x:Name="chkRememberDndMode"
                                              Content="记住勿扰状态"
                                              Margin="12,2,0,2" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Style="{StaticResource InfoTipStyle}"
                                               ToolTip="开启后，勿扰模式状态会保存到配置中，下次启动时自动恢复。"/>
                                </Grid>

                                <!-- ★★★ 小鸟依人模式 ★★★ -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" x:Name="chkClingMode"
                                              Content="🐦 小鸟依人模式"
                                              Margin="0,2,0,2" FontSize="12"/>
