                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,6,0,0"/>
                                <TextBlock Text="第三方组件声明见仓库 THIRD-PARTY-NOTICES.md（MIT 协议）。"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#888888"
                                           Margin="0,4,0,0"/>
