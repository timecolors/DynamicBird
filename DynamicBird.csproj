<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<!-- 宸插畨瑁呮洿楂樹富鐗堟湰杩愯鏃讹紙濡?.NET 11锛夋椂鍏佽婊氬姩 -->
		<RollForward>LatestMajor</RollForward>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>assets\icon.ico</ApplicationIcon>
		<AssemblyName>DynamicBird</AssemblyName>
		<RootNamespace>DynamicBird</RootNamespace>

		<!-- 鈽呪槄鈽?鐗堟湰涓庝骇鍝佷俊鎭紙鏄剧ず鍦ㄦ枃浠跺睘鎬?浠诲姟绠＄悊鍣?鍏充簬椤碉級 鈽呪槄鈽?-->
		<Version>1.0.3</Version>
		<FileVersion>1.0.3.0</FileVersion>
		<AssemblyVersion>1.0.3.0</AssemblyVersion>
		<Product>鐏靛姩楦?DynamicBird</Product>
		<AssemblyTitle>鐏靛姩楦?/AssemblyTitle>
		<Description>Windows 妗岄潰杈圭紭闈㈡澘宸ュ叿</Description>
		<Copyright>Copyright 漏 2026 TideHue</Copyright>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<!-- 鈽呪槄鈽?绂佺敤鎵€鏈夐粯璁ゅ寘鍚」锛堥伩鍏嶉噸澶嶏級 鈽呪槄鈽?-->
		<EnableDefaultItems>false</EnableDefaultItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- 渚涘崟鍏冩祴璇曡闂?internal 鎴愬憳 -->
		<InternalsVisibleTo Include="DynamicBird.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- NuGet 鍖?-->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="System.Management" Version="10.0.11" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- 鈽呪槄鈽?App.xaml 鈽呪槄鈽?-->
		<ApplicationDefinition Include="App.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</ApplicationDefinition>

		<!-- 鈽呪槄鈽?鎵€鏈?XAML 鏂囦欢锛圥age锛?鈽呪槄鈽?-->
		<Page Include="src\UI\Main\MainWindow.xaml" />
		<Page Include="src\UI\Panels\TaskbarView.xaml" />
		<Page Include="src\UI\Settings\SettingsWindow.xaml" />
		<Page Include="src\UI\Settings\WeatherCityPickerWindow.xaml" />
		<Page Include="src\UI\Settings\Pages\ShortcutManagementPage.xaml" />
		<Page Include="src\UI\Status\SystemStatusView.xaml" />
		<Page Include="src\UI\Theme\Theme.xaml" />
		<Page Include="src\UI\Theme\AppIcons.xaml" />
		<Page Include="src\UI\AppHelper\AppHelperView.xaml" />
		<Page Include="src\UI\AppHelper\MediaControlView.xaml" />
		<Page Include="src\UI\Panels\NotificationDockView.xaml" />
		<Page Include="src\UI\Panels\RecentItemsView.xaml" />
		<Page Include="src\UI\Panels\QuickSettingsView.xaml" />
		<Page Include="src\UI\Media\PanelMediaPlayer.xaml" />
		<Page Include="src\UI\Media\WindowPickerWindow.xaml" />
		<Page Include="src\UI\Onboarding\OnboardingWindow.xaml" />
		<Page Include="src\UI\Widgets\Calculator\CalculatorWidget.xaml" />
		<Page Include="src\UI\Widgets\Timer\TimerWidget.xaml" />
		<Page Include="src\UI\Widgets\ClipboardHistory\ClipboardHistoryWidget.xaml" />
		<Page Include="src\UI\Widgets\Notes\NoteWidget.xaml" />
		<Page Include="src\UI\Widgets\WidgetSwitcher.xaml" />
		<Page Include="src\UI\Widgets\Dynamic\WidgetEditorWindow.xaml" />
    <Page Include="src\UI\Widgets\Dynamic\WidgetMarketWindow.xaml" />
		<Page Include="src\UI\Widgets\TextAi\TextAiWidget.xaml" />
		<Page Include="src\UI\Widgets\WindowControlView.xaml" />
		<Page Include="src\UI\AI\AiChatView.xaml" />

		<!-- 鈽呪槄鈽?鎵€鏈?CS 鏂囦欢锛堥€掑綊鍖呭惈锛?鈽呪槄鈽?-->
		<Compile Include="src\**\*.cs" Exclude="**\obj\**\*.cs" />
		<Compile Remove="src\UI\Debug\**" />
		<Compile Include="App.xaml.cs" />
		<Compile Include="Properties\Settings.Designer.cs" />

		<!-- 鈽呪槄鈽?璧勬簮鏂囦欢 鈽呪槄鈽?-->
		<None Update="assets\icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- 鈽呪槄鈽?鏈湴鍖栬祫婧愶紙涓€?zh-CN锛宔n-US 鍗槦璧勬簮锛?鈽呪槄鈽?-->
		<EmbeddedResource Include="src\UI\Localization\Strings.resx">
			<LogicalName>DynamicBird.UI.Localization.Strings.resources</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="src\UI\Localization\Strings.en-US.resx">
			<LogicalName>DynamicBird.UI.Localization.Strings.en-US.resources</LogicalName>
		</EmbeddedResource>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>

