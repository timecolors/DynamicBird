<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>assets\icon.ico</ApplicationIcon>
		<AssemblyName>DynamicBird</AssemblyName>
		<RootNamespace>DynamicBird</RootNamespace>

		<!-- ★★★ 禁用所有默认包含项（避免重复） ★★★ -->
		<EnableDefaultItems>false</EnableDefaultItems>
	</PropertyGroup>

	<ItemGroup>
		<!-- COM 引用 -->
		<COMReference Include="Shell32">
			<WrapperTool>tlbimp</WrapperTool>
			<VersionMinor>0</VersionMinor>
			<VersionMajor>1</VersionMajor>
			<Guid>50a7e9b0-70ef-11d1-b75a-00a0c90564fe</Guid>
			<Lcid>0</Lcid>
			<Isolated>false</Isolated>
			<EmbedInteropTypes>true</EmbedInteropTypes>
		</COMReference>

		<!-- NuGet 包 -->
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<!-- ★★★ App.xaml ★★★ -->
		<ApplicationDefinition Include="App.xaml">
			<Generator>MSBuild:Compile</Generator>
			<SubType>Designer</SubType>
		</ApplicationDefinition>

		<!-- ★★★ 所有 XAML 文件（Page） ★★★ -->
		<Page Include="src\UI\Main\MainWindow.xaml" />
		<Page Include="src\UI\Panels\TaskbarView.xaml" />
		<Page Include="src\UI\Settings\SettingsWindow.xaml" />
		<Page Include="src\UI\Settings\Pages\ShortcutManagementPage.xaml" />
		<Page Include="src\UI\Status\SystemStatusView.xaml" />
		<Page Include="src\UI\Widgets\ClipboardHistory\ClipboardHistoryWidget.xaml" />
		<Page Include="src\UI\Widgets\Notes\NoteWidget.xaml" />
		<Page Include="src\UI\Widgets\WidgetSwitcher.xaml" />

		<!-- ★★★ 所有 CS 文件（递归包含） ★★★ -->
		<Compile Include="src\**\*.cs" Exclude="**\obj\**\*.cs" />
		<Compile Remove="src\UI\Debug\**" />
		<Compile Include="App.xaml.cs" />
		<Compile Include="Properties\Settings.Designer.cs" />

		<!-- ★★★ 资源文件 ★★★ -->
		<None Update="assets\icon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>