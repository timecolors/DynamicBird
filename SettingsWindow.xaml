<Window x:Class="LingDongBird.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🐦 灵动鸟 设置"
        Height="720" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F5F5"
        Foreground="#1E1E1E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="🐦 灵动鸟 设置" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <TabControl Grid.Row="1" 
                    Background="Transparent"
                    BorderBrush="#DDDDDD"
                    FontSize="13">

            <!-- ====== 选项卡1：触发位置 ====== -->
            <TabItem Header="⚙️ 触发位置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="边缘触发" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,15">
                            <CheckBox x:Name="chkTop" Content="上边" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkBottom" Content="下边" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkLeft" Content="左边" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkRight" Content="右边" Margin="0,0,15,5" IsChecked="True"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,20">
                            <CheckBox x:Name="chkTopLeft" Content="左上角" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkTopRight" Content="右上角" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkBottomLeft" Content="左下角" Margin="0,0,15,5" IsChecked="True"/>
                            <CheckBox x:Name="chkBottomRight" Content="右下角" Margin="0,0,15,5" IsChecked="True"/>
                        </WrapPanel>

                        <TextBlock Text="边行为模式" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="上边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbTopMode" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="跟随鼠标"/>
                                <ComboBoxItem Content="固定位置"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="下边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbBottomMode" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="跟随鼠标"/>
                                <ComboBoxItem Content="固定位置"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="左边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbLeftMode" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="跟随鼠标"/>
                                <ComboBoxItem Content="固定位置"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="右边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbRightMode" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="跟随鼠标"/>
                                <ComboBoxItem Content="固定位置"/>
                            </ComboBox>
                        </Grid>

                        <!-- 固定位置形状 -->
                        <TextBlock Text="固定位置形状（固定模式下生效）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="上边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbFixedShapeTop" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="下边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbFixedShapeBottom" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="左边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbFixedShapeLeft" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="右边" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cmbFixedShapeRight" SelectedIndex="0" Width="120">
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 选项卡2：外观 ====== -->
            <TabItem Header="🎨 外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="颜色" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="背景色" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtBgColor" Text="#2D2D2D" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="2" x:Name="btnBgColorPicker" Content="选择" Width="60" Height="25" Click="BtnBgColorPicker_Click" Margin="10,0,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="文字色" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTextColor" Text="#FFFFFF" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="2" x:Name="btnTextColorPicker" Content="选择" Width="60" Height="25" Click="BtnTextColorPicker_Click" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="面板透明度" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="sldOpacity" Minimum="0" Maximum="1" Value="0.85" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="txtOpacityValue" Text="0.85" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="圆角大小" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="sldCornerRadius" Minimum="0" Maximum="30" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="txtCornerRadiusValue" Text="16" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <!-- 自定义图标 -->
                        <TextBlock Text="自定义图标" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtCustomIcon" Text="" IsReadOnly="True" VerticalAlignment="Center" Background="#EEEEEE"/>
                            <Button Grid.Column="1" x:Name="btnSelectIcon" Content="选择图片" Width="90" Height="25" Click="BtnSelectIcon_Click" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="功能开关" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="chkShowSystemStatus" Content="显示系统状态" Margin="0,0,0,10" IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 选项卡3：形状与区域 ====== -->
            <TabItem Header="📐 形状与区域">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="全局尺寸参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="长条长度比例" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldStripLength" Minimum="0.2" Maximum="0.9" Value="0.6" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtStripLength" Text="60%" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="长条宽度倍数（×任务栏）" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldStripWidth" Minimum="0.5" Maximum="3.0" Value="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtStripWidth" Text="1.5" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="方形短边倍数（×长条宽）" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldSquareShort" Minimum="1.0" Maximum="4.0" Value="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtSquareShort" Text="1.8" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="黄金分割比" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldGolden" Minimum="1.0" Maximum="3.0" Value="1.618" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtGolden" Text="1.62" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="中间区域比例" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldRegionRatio" Minimum="0.1" Maximum="0.8" Value="0.33" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtRegionRatio" Text="33%" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="📋 每条边区域形状（左/中/右）" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,10"/>
                        <TextBlock Text="提示：选择'默认'则使用全局逻辑（中间方形，两侧长条）" FontSize="12" Foreground="#888888" Margin="0,0,0,10"/>

                        <!-- 上边区域 -->
                        <TextBlock Text="上边" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="左/中/右" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmbTopLeft" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="cmbTopCenter" SelectedIndex="0" Width="100" Margin="10,0,10,0">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="3" x:Name="cmbTopRight" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                        </Grid>

                        <!-- 下边区域 -->
                        <TextBlock Text="下边" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="左/中/右" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmbBottomLeft" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="cmbBottomCenter" SelectedIndex="0" Width="100" Margin="10,0,10,0">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="3" x:Name="cmbBottomRight" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                        </Grid>

                        <!-- 左边区域 -->
                        <TextBlock Text="左边" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="上/中/下" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmbLeftTop" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="cmbLeftCenter" SelectedIndex="0" Width="100" Margin="10,0,10,0">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="3" x:Name="cmbLeftBottom" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                        </Grid>

                        <!-- 右边区域 -->
                        <TextBlock Text="右边" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,5"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="上/中/下" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cmbRightTop" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="cmbRightCenter" SelectedIndex="0" Width="100" Margin="10,0,10,0">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                            <ComboBox Grid.Column="3" x:Name="cmbRightBottom" SelectedIndex="0" Width="100">
                                <ComboBoxItem Content="默认"/>
                                <ComboBoxItem Content="方形"/>
                                <ComboBoxItem Content="横条"/>
                                <ComboBoxItem Content="竖条"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 选项卡4：布局与动画 ====== -->
            <TabItem Header="⏱️ 布局与动画">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="标签横排" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="当面板宽度超过阈值时，窗口标签自动切换为横向排列" FontSize="12" Foreground="#888888" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="横排触发阈值（比例）" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldHorizontalThreshold" Minimum="0.1" Maximum="0.9" Value="0.43" TickFrequency="0.01" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtHorizontalThreshold" Text="43%" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="标签宽度（像素）" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldTagWidth" Minimum="40" Maximum="300" Value="120" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtTagWidth" Text="120" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="⏱️ 动画" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,10"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="动画时长（毫秒）" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="sldAnimDuration" Minimum="10" Maximum="300" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="txtAnimDuration" Text="50" TextAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock FontSize="12" Foreground="#888888" Text="💡 提示：长条比例 = 面板长度占屏幕对应边长的比例；方形短边 = 长条宽度 × 倍数" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====== 选项卡5：关于/模式 ====== -->
            <TabItem Header="ℹ️ 关于">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="🐦 灵动鸟 v1.0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="当前模式：" FontSize="14" Margin="0,5,0,0"/>
                    <TextBlock x:Name="txtCurrentMode" Text="任务栏模式" FontSize="14" Foreground="#0078D4" FontWeight="SemiBold" Margin="0,2,0,10"/>
                    <TextBlock Text="点击面板上的鸟图标切换模式" FontSize="12" Foreground="#888888" Margin="0,0,0,5"/>
                    <TextBlock Text="任务栏模式 — 完整的窗口管理和切换功能" FontSize="12" Foreground="#666666" Margin="0,2,0,2"/>
                    <TextBlock Text="应用辅助模式 — 功能开发中" FontSize="12" Foreground="#666666" Margin="0,2,0,10"/>

                    <Separator Margin="0,20,0,15"/>

                    <TextBlock Text="📖 操作提示" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="• 每条边可独立设置形状类型" FontSize="12" Foreground="#666666" Margin="0,2,0,2"/>
                    <TextBlock Text="• 超过横排阈值时，任务标签自动水平排列" FontSize="12" Foreground="#666666" Margin="0,2,0,2"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="保存" Width="80" Height="30" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button x:Name="btnClose" Content="关闭" Width="80" Height="30" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>